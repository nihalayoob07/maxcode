{
  "name": "max-code",
  "productName": "Max Code",
  "version": "0.1.0",
  "description": "Max's coding tutor and debugger, on its own",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nihal.maxcode",
    "productName": "Max Code",
    "copyright": "Copyright © 2026 Nihal",
    "files": [
      "main.js",
      "preload.js",
      "shared/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "!**/onnxruntime-node/bin/napi-v*/{darwin,linux}/**",
      "!**/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!**/.cache/**",
      "!**/onnxruntime-web/**",
      "!**/*.map",
      "!**/@huggingface/transformers/dist/*.web*",
      "!**/@huggingface/transformers/dist/*.min.*",
      "!**/@huggingface/transformers/types/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Max Code",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MaxCode-Setup.${ext}"
    },
    "asarUnpack": [
      "**/*.node",
      "**/onnxruntime-node/**",
      "**/@img/**",
      "**/sharp/**"
    ]
  }
}
